{
  "name": "@avarlabs/editor",
  "version": "0.1.1",
  "description": "Korean-first rich text editor for blogs, built on Lexical. Upload, storage, copy and colors are all injected.",
  "keywords": [
    "editor",
    "lexical",
    "rich-text",
    "wysiwyg",
    "react",
    "korean"
  ],
  "license": "MIT",
  "author": "AvarLabs",
  "homepage": "https://github.com/cochoio/editor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cochoio/editor.git"
  },
  "bugs": "https://github.com/cochoio/editor/issues",
  "type": "module",
  "sideEffects": [
    "*.css",
    "**/CodeHighlightPlugin.*",
    "**/prism-global.*",
    "./dist/index.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sanitize": {
      "types": "./dist/format/sanitize.d.ts",
      "default": "./dist/format/sanitize.js"
    },
    "./styles/editor.css": "./dist/styles/editor.css",
    "./styles/reader.css": "./dist/styles/reader.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -R src/styles dist/styles",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest run",
    "test:dist": "pnpm run build && vitest run -c vitest.dist.config.ts",
    "test:e2e": "pnpm run build && playwright test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run check && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "peerDependencies": {
    "@lexical/code": "^0.50.0",
    "@lexical/code-prism": "^0.50.0",
    "@lexical/html": "^0.50.0",
    "@lexical/link": "^0.50.0",
    "@lexical/list": "^0.50.0",
    "@lexical/markdown": "^0.50.0",
    "@lexical/react": "^0.50.0",
    "@lexical/rich-text": "^0.50.0",
    "@lexical/selection": "^0.50.0",
    "@lexical/table": "^0.50.0",
    "@lexical/utils": "^0.50.0",
    "lexical": "^0.50.0",
    "prismjs": "^1.30.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@lexical/code": "^0.50.0",
    "@lexical/code-prism": "^0.50.0",
    "@lexical/history": "^0.50.0",
    "@lexical/html": "^0.50.0",
    "@lexical/link": "^0.50.0",
    "@lexical/list": "^0.50.0",
    "@lexical/markdown": "^0.50.0",
    "@lexical/react": "^0.50.0",
    "@lexical/rich-text": "^0.50.0",
    "@lexical/selection": "^0.50.0",
    "@lexical/table": "^0.50.0",
    "@lexical/utils": "^0.50.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "happy-dom": "^20.14.3",
    "jsdom": "^30.1.1",
    "lexical": "^0.50.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.11.0"
}
